# --- LLM ---
# Two providers:
#   ollama  local Ollama server, native /api/chat — no API key, no token cost
#   openai  any OpenAI-compatible /chat/completions gateway (OpenAI, OpenRouter,
#           vLLM, llama.cpp, a corporate gateway, …)
# "auto" picks ollama when the base URL looks like an Ollama host.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=                # leave empty for local ollama
LLM_MODEL=gemma4:26b        # must be pulled: `ollama pull gemma4:26b`

# Ollama Cloud instead (same native API, hosted — no local GPU needed):
# LLM_PROVIDER=ollama
# LLM_BASE_URL=https://ollama.com
# LLM_API_KEY=<key from https://ollama.com/settings/keys>
# LLM_MODEL=gpt-oss:120b

# Hosted OpenAI-compatible gateway instead:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# --- Ollama tuning (ignored when LLM_PROVIDER=openai) ---
LLM_NUM_CTX=8192            # must fit MAX_CONTENT_CHARS/4 + prompt, or input is truncated
LLM_MAX_NUM_CTX=32768       # ceiling when a call needs a bigger window (weekly skills analysis)
LLM_THINK=false             # thinking eats the output budget without better JSON
LLM_KEEP_ALIVE=30m          # keep weights resident between calls (-1 = forever)
LLM_STARTUP_WAIT=120        # seconds to wait for the server (cron can beat it to boot)
LLM_TIMEOUT=                # per-call seconds; blank = 900 (ollama) / EXTRACT_TIMEOUT
LLM_CONCURRENCY=            # parallel model calls; blank = 1 (ollama) / CONCURRENCY

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl          # ssl | starttls | plain
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=you@gmail.com
MAIL_TO=you@gmail.com

# --- Briefing options ---
# SOURCES: comma/newline separated feed or page URLs. Leave blank to use the
# bundled curated "AI News" preset (25 sources).
SOURCES=
KEYWORDS=                  # comma-separated relevance filter; blank = no filter
WINDOW_HOURS=24
PER_FEED_LIMIT=10
DETAIL_LIMIT=20            # full cards; the rest render as a compact list
CONCURRENCY=3              # parallel article fetches
EXTRACT_TIMEOUT=90         # legacy LLM timeout fallback; prefer LLM_TIMEOUT
MAX_CONTENT_CHARS=12000
LLM_MAX_RETRIES=4          # retry throttled (429) / 5xx LLM calls
LLM_BACKOFF_BASE=2         # seconds; exponential with jitter

# --- PDF archive ---
SAVE_PDF=true               # dated PDF saved next to the script each run
PDF_DIR=                    # blank = this folder
ATTACH_PDF=false            # also attach the PDF to the email

# --- Weekly CV skills gap (brief.py --weekly / ./skills.py) ---
CV_PATH=                    # blank = Vinay_Balraj_AI_Developer_CV.pdf in this folder
SKILLS_WINDOW_DAYS=7        # days of news history the analysis reads
MAX_SKILL_GAPS=8            # entries in "skills to acquire"
HISTORY_KEEP_DAYS=60        # prune daily history older than this
