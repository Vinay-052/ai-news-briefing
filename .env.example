# --- LLM (OpenAI-compatible /chat/completions endpoint) ---
LLM_BASE_URL=https://your-gateway.example.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=claude-opus-4-7

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl          # ssl | starttls | plain
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=you@gmail.com
MAIL_TO=you@gmail.com

# --- Briefing options ---
# SOURCES: comma/newline separated feed or page URLs. Leave blank to use the
# bundled curated "AI News" preset (25 sources).
SOURCES=
KEYWORDS=                  # comma-separated relevance filter; blank = no filter
WINDOW_HOURS=24
PER_FEED_LIMIT=10
DETAIL_LIMIT=20            # full cards; the rest render as a compact list
CONCURRENCY=3
EXTRACT_TIMEOUT=90
MAX_CONTENT_CHARS=12000
LLM_MAX_RETRIES=4          # retry throttled (429) / 5xx LLM calls
LLM_BACKOFF_BASE=2         # seconds; exponential with jitter

# --- PDF archive ---
SAVE_PDF=true               # dated PDF saved next to the script each run
PDF_DIR=                    # blank = this folder
ATTACH_PDF=false            # also attach the PDF to the email

# --- Weekly CV skills gap (brief.py --weekly / ./skills.py) ---
CV_PATH=                    # blank = Vinay_Balraj_AI_Developer_CV.pdf in this folder
SKILLS_WINDOW_DAYS=7        # days of news history the analysis reads
MAX_SKILL_GAPS=8            # entries in "skills to acquire"
HISTORY_KEEP_DAYS=60        # prune daily history older than this
